App(
    appid="pulse_rhythm",
    name="Pulse Rhythm",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pulse_app",
    requires=["gui", "storage", "notification"],
    stack_size=8 * 1024,
    fap_category="Games",
    fap_author="Pulse Team",
    fap_version="1.0",
    fap_description="Full-featured rhythm game with built-in soundtrack, level editor (.frgl), anomalies, characters, and Video Game Module support.",
    sources=[
        "pulse.c",
        "scenes/*.c",
        "views/*.c",
        "game/*.c",
        "songs/*.c",
    ],
)
